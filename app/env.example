# Copy to app/.env (git-ignored); use your laptop's hotspot IP, not localhost.
EXPO_PUBLIC_ECHO_SERVER_URL=http://172.20.10.2:3000
# Local phone config. These values are visible in the app bundle, not server secrets.
EXPO_PUBLIC_ECHO_MOM_NUMBER=
# true replaces Call 911 with a clearly labeled demo dialer button. Never dials automatically.
EXPO_PUBLIC_ECHO_DEMO_CALLS=true
EXPO_PUBLIC_ECHO_DEMO_NUMBER=
