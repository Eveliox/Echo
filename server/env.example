# Template for server/.env (git-ignored). Copy it: cp server/env.example server/.env
# then put real values in server/.env only. Never commit real values.
# ECHO_CALLS is not set here: pass it on the command line (only "live" dials).

# Twilio console > Account info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Your Twilio phone number, E.164 format
TWILIO_FROM_NUMBER=+15550000000

# Backup ladder Contact #1 (on a trial account the number must be verified in Twilio)
CONTACT1_NAME=Contact One
CONTACT1_NUMBER=+15550000001

# Backup ladder Contact #2 (optional: without a number, step 3 is skipped and step 4 calls Contact #1 only)
CONTACT2_NAME=Contact Two
CONTACT2_NUMBER=+15550000002

# Box token auth (optional). With this set, POST /status needs the same value in
# the X-Echo-Token header or gets 401. Leave it commented out until the ESP
# firmware that sends the header (ticket #17) is flashed: setting it before then
# makes the server reject every box status, so no ladder calls.
# Use a hex token, e.g. from `openssl rand -hex 24`: a non-ASCII token never
# matches, and a `#` may be cut off by the .env parser.
# ECHO_BOX_TOKEN=<hex-token-also-in-firmware/esp/secrets.h>

# Responder, the AI agent (optional). Without a key it is off and the backup
# ladder runs alone, exactly as before. Key from Google AI Studio; set a
# spending cap on its Google Cloud project before using it.
GEMINI_API_KEY=
# Optional: the Gemini model name; blank uses the server's default (server/gemini.js).
GEMINI_MODEL=

# Live voice on the Responder's calls and the ladder's first call to Contact #1
# (optional, ticket #19; setup in server/voice/agent.md). Without all three,
# those calls use the Twilio spoken alert, as before. Every other ladder call
# always uses it. Use a restricted API key (ElevenLabs Agents only).
ELEVENLABS_API_KEY=
# The agent's ID, from its page in the ElevenLabs dashboard
ELEVENLABS_AGENT_ID=
# The ID ElevenLabs gives the imported Twilio number (Phone Numbers page), not the number itself
ELEVENLABS_PHONE_NUMBER_ID=
# Shared secret for the voice agent's tool webhooks: the same value goes in the
# X-Echo-Voice-Secret header of each tool in ElevenLabs. Without it the tools are off.
# Use a hex value, e.g. from `openssl rand -hex 24`.
# ECHO_VOICE_SECRET=<hex-secret-also-in-the-elevenlabs-tool-headers>
# Port for the tool webhooks (default 3100). Tunnel only this port, never 3000.
# ECHO_VOICE_PORT=3100

# Databricks log uploader (optional, dev tooling: simulator/databricks_upload.js).
# The server never reads these; they only copy logs to the #14 notebook's Volume.
# Workspace URL, https only, no path
# DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
# Personal access token (Settings > Developer > Access tokens); keep it in server/.env only
# DATABRICKS_TOKEN=<personal-access-token>
# Volume folder for the logs (default /Volumes/workspace/default/echo_logs)
# DATABRICKS_VOLUME_PATH=/Volumes/workspace/default/echo_logs
# Optional: the heat_test notebook job's ID, so --run can start it
# DATABRICKS_JOB_ID=<job-id>

# Saving contacts from the app (optional). With a PIN of 6 to 12 digits set, a
# parent can replace the contact list from the app's Contacts tab by typing
# it. The list is saved to server/contacts.json (git-ignored) and replaces the
# CONTACT* settings above the next time the server starts. Unset = off.
# ECHO_CONTACTS_PIN=
